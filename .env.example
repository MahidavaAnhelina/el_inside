# Copy to .env.local only if that file does not already exist.
# Never commit real credentials. All keys below are server-only except the site key.
SITE_URL=http://localhost:3000
# Explicitly enable only after configuring protection and delivery.
ORDERS_ENABLED=false
ORDER_DELIVERY=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public widget key: safe to expose to the browser, not the secret below.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Use one stable namespace for production across deployments and aliases.
# Use a different namespace/database for local development and previews.
ORDER_LIMIT_NAMESPACE=local
# Optional alternative delivery. Requires ORDER_DELIVERY=resend and a verified domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ORDER_TO_EMAIL=
